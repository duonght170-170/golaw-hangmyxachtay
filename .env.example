# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env và điền thông tin thật của bạn

# Resend API Key
RESEND_API_KEY=your_resend_api_key_here

# Domain & Sender Email
DOMAIN=yourdomain.com
SENDER_EMAIL=CostcoHealth USA <hi@yourdomain.com>

# VietQR Sepay Config
SEPAY_BANK_CODE=MB
SEPAY_ACC_NUMBER=your_account_number
SEPAY_ACC_NAME=YOUR_FULL_NAME

# Cloud Database (Google Sheets Apps Script API)
GOOGLE_CLOUD_URL=https://script.google.com/macros/s/your_apps_script_id/exec
